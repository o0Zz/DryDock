**/.git
# The root .git is read by the Dockerfile's version stage (commit count). The
# index changes on every `git add` and is not needed to count commits.
!.git
.git/index
**/.gitignore
**/.vscode
**/.idea
**/.DS_Store

# Python
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.venv
**/.pytest_cache
**/.ruff_cache

# Node
**/node_modules
**/dist
**/.vite

# Local data & test fixtures (image should ship empty)
backend/.data
sample-repo

# Docs & metadata that don't affect the build
CLAUDE.md
README.md
docs
Dockerfile
.dockerignore
docker-compose.yml
